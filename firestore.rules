rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBook(data) {
      return data.keys().hasAll(['title', 'classLevel', 'subject', 'condition', 'pickupLocation', 'status'])
        && data.title is string && data.title.size() > 0
        && data.classLevel is string && data.classLevel.size() > 0
        && data.subject is string && data.subject.size() > 0
        && data.condition in ['Like New', 'Very Good', 'Good', 'Fair']
        && data.pickupLocation is string && data.pickupLocation.size() > 0
        && data.status in ['available', 'taken', 'claimed'];
    }

    // Books Collection: Public directory of textbooks for student exchange
    match /books/{bookId} {
      allow read: if true;
      allow create: if isValidId(bookId) && isValidBook(request.resource.data);
      allow update: if isValidId(bookId) && isValidBook(request.resource.data);
      allow delete: if isValidId(bookId);
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }
  }
}
